@article{junier2025termal,
    author = {Junier, Thomas},
    title = {Termal: a fast and interactive terminal-based viewer for multiple sequence alignments},
    journal = {Bioinformatics Advances},
    pages = {vbaf208},
    year = {2025},
    month = {09},
    abstract = {We present termal, a fast, interactive, terminal-based viewer for multiple sequence alignments (MSAs), designed for use on remote systems such as high-performance computing (HPC) clusters. Unlike traditional graphical viewers, termal runs entirely within a terminal, but like graphical viewers, it offers features such as scrolling, zooming, consensus/conservation visualization, and colour schemes.},
    issn = {2635-0041},
    doi = {10.1093/bioadv/vbaf208},
    url = {https://doi.org/10.1093/bioadv/vbaf208},
    eprint = {https://academic.oup.com/bioinformaticsadvances/advance-article-pdf/doi/10.1093/bioadv/vbaf208/64316542/vbaf208.pdf},
}
